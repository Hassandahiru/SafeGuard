{
  "info": {
    "name": "SafeGuard Notification Testing",
    "description": "Complete collection for testing the SafeGuard notification service including visitor notifications, admin approvals, emergency alerts, and real-time Socket.io events.",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "api_version",
      "value": "api",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "your_jwt_token_here",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "123e4567-e89b-12d3-a456-426614174000",
      "type": "string"
    },
    {
      "key": "building_id",
      "value": "123e4567-e89b-12d3-a456-426614174000",
      "type": "string"
    },
    {
      "key": "visitor_id",
      "value": "123e4567-e89b-12d3-a456-426614174000",
      "type": "string"
    },
    {
      "key": "approval_id",
      "value": "123e4567-e89b-12d3-a456-426614174000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Login - Resident",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.to.have.status(200)) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', jsonData.data.token);",
                  "    pm.collectionVariables.set('user_id', jsonData.data.user.id);",
                  "    pm.collectionVariables.set('building_id', jsonData.data.user.building_id);",
                  "    console.log('Token set:', jsonData.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"resident@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{api_version}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["{{api_version}}", "auth", "login"]
            }
          }
        },
        {
          "name": "Login - Building Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@building.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{api_version}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["{{api_version}}", "auth", "login"]
            }
          }
        },
        {
          "name": "Login - Security",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"security@building.com\",\n  \"password\": \"security123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{api_version}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["{{api_version}}", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "👥 Visitor Notifications",
      "item": [
        {
          "name": "Create Visitor (Triggers Security Notification)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.to.have.status(201)) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('visitor_id', jsonData.data.visitor.id);",
                  "    console.log('✅ Visitor created, should trigger notification to security');",
                  "    console.log('Visitor ID:', jsonData.data.visitor.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Test Visitor\",\n  \"phone\": \"+1234567890\",\n  \"purpose\": \"Testing notification service\",\n  \"expected_start\": \"{{$isoTimestamp}}\",\n  \"expected_end\": \"2024-12-31T18:00:00Z\",\n  \"visitor_type\": \"guest\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{api_version}}/visitors",
              "host": ["{{base_url}}"],
              "path": ["{{api_version}}", "visitors"]
            }
          }
        },
        {
          "name": "QR Scan - Entry (Triggers Arrival Notification)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.to.have.status(200)) {",
                  "    console.log('✅ QR scanned for entry, should trigger visitor arrival notification to host');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"visitor_id\": \"{{visitor_id}}\",\n  \"scan_type\": \"entry\",\n  \"location\": \"Main Gate\",\n  \"scanned_by\": \"{{user_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{api_version}}/visits/scan-qr",
              "host": ["{{base_url}}"],
              "path": ["{{api_version}}", "visits", "scan-qr"]
            }
          }
        },
        {
          "name": "QR Scan - Exit (Triggers Exit Notification)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.to.have.status(200)) {",
                  "    console.log('✅ QR scanned for exit, should trigger visitor exit notification to host');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"visitor_id\": \"{{visitor_id}}\",\n  \"scan_type\": \"exit\",\n  \"location\": \"Main Gate\",\n  \"scanned_by\": \"{{user_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{api_version}}/visits/scan-qr",
              "host": ["{{base_url}}"],
              "path": ["{{api_version}}", "visits", "scan-qr"]
            }
          }
        }
      ]
    },
    {
      "name": "🏢 Admin Approval Notifications",
      "item": [
        {
          "name": "Process Approval - Approve (Triggers Notification)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.to.have.status(200)) {",
                  "    console.log('✅ Resident approved, should trigger approval notification');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approved\": true,\n  \"notes\": \"Testing notification service - resident approved for building access\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{api_version}}/resident-approval/{{approval_id}}/process",
              "host": ["{{base_url}}"],
              "path": ["{{api_version}}", "resident-approval", "{{approval_id}}", "process"]
