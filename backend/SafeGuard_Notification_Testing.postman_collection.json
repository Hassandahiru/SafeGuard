            "body": {
              "mode": "raw",
              "raw": "{\n  \"approved\": false,\n  \"reason\": \"Documentation incomplete - missing proof of residence\",\n  \"notes\": \"Testing notification service - please resubmit with complete documents\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{api_version}}/resident-approval/{{approval_id}}/process",
              "host": ["{{base_url}}"],
              "path": ["{{api_version}}", "resident-approval", "{{approval_id}}", "process"]
            }
          }
        }
      ]
    },
