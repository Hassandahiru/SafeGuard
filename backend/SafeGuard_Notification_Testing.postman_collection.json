            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Testing notification service - Resident has moved out and requested account deactivation\",\n  \"effective_date\": \"{{$isoTimestamp}}\",\n  \"notify_resident\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/{{api_version}}/admin/residents/disengage/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["{{api_version}}", "admin", "residents", "disengage", "{{user_id}}"]
            }
          }
        },
        {
          "name": "Ban Visitor (Triggers Notification)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.to.have.status(201)) {",
                  "    console.log('🚫 Visitor banned, should trigger notification to resident');",
