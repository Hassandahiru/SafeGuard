    {
      "name": "👤 Resident Management Notifications",
      "item": [
        {
          "name": "Disengage Resident (Triggers Notification)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.to.have.status(200)) {",
