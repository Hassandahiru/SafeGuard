    {
      "name": "🔔 Notification Management",
      "item": [
        {
          "name": "Get User Notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.to.have.status(200)) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log('📋 User notifications:', jsonData.data.notifications.length);",
                  "    if (jsonData.data.notifications.length > 0) {",
                  "        pm.collectionVariables.set('notification_id', jsonData.data.notifications[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/{{api_version}}/notifications?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["{{api_version}}", "notifications"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Notification Counts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.to.have.status(200)) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log('📊 Notification counts - Total:', jsonData.data.total, 'Unread:', jsonData.data.unread);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/{{api_version}}/notifications/counts",
              "host": ["{{base_url}}"],
              "path": ["{{api_version}}", "notifications", "counts"]
            }
          }
        },
        {
          "name": "Mark Notification as Read",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.to.have.status(200)) {",
                  "    console.log('✅ Notification marked as read, should trigger real-time update');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/{{api_version}}/notifications/{{notification_id}}/read",
              "host": ["{{base_url}}"],
              "path": ["{{api_version}}", "notifications", "{{notification_id}}", "read"]
            }
          }
        },
        {
          "name": "Mark All Notifications as Read",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.to.have.status(200)) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log('✅ All notifications marked as read. Count:', jsonData.data.marked_count);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/{{api_version}}/notifications/read-all",
              "host": ["{{base_url}}"],
              "path": ["{{api_version}}", "notifications", "read-all"]
            }
          }
        }
      ]
    },
