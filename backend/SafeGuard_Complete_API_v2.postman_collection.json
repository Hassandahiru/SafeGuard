        {
          "name": "Admin - Delete User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Only run if user has admin privileges",
                  "if (!pm.environment.get('can_manage_users')) {",
                  "    console.log('Skipping test - user does not have admin privileges');",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User deleted successfully or access denied', function () {",
                  "    const statusCode = pm.response.code;",
                  "    pm.expect([200, 403]).to.include(statusCode);",
                  "    ",
                  "    if (statusCode === 200) {",
                  "        pm.expect(pm.response.json().success).to.be.true;",
                  "        pm.expect(pm.response.json().data.deleted_user_id).to.exist;",
                  "    } else if (statusCode === 403) {",
                  "        pm.expect(pm.response.json().success).to.be.false;",
                  "        pm.expect(pm.response.json().error.code).to.eq('AUTHORIZATION_ERROR');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/settings/users/{{user_id_to_delete}}",
              "host": ["{{base_url}}"],
              "path": ["api", "settings", "users", "{{user_id_to_delete}}"]
            },
            "description": "Delete a user (Admin only). Set user_id_to_delete in environment variables."
          }
