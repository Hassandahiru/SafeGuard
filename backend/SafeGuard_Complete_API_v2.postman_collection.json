    {
      "name": "Visitor Management",
      "item": [
        {
          "name": "Create Visit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var response = pm.response.json();",
                  "    if (response.success && response.data.visit_id) {",
                  "        pm.environment.set('visit_id', response.data.visit_id);",
                  "        pm.environment.set('qr_code', response.data.qr_code);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Business Meeting\",\n  \"description\": \"Meeting with client about project\",\n  \"expected_start\": \"{{$isoTimestamp}}\",\n  \"expected_end\": \"{{$isoTimestamp}}\",\n  \"visitors\": [\n    {\n      \"name\": \"John Visitor\",\n      \"phone\": \"+1111111111\",\n      \"email\": \"visitor1@example.com\",\n      \"company\": \"ABC Corp\"\n    },\n    {\n      \"name\": \"Jane Visitor\",\n      \"phone\": \"+2222222222\",\n      \"email\": \"visitor2@example.com\",\n      \"company\": \"XYZ Inc\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/visitors/create",
              "host": ["{{base_url}}"],
              "path": ["api", "visitors", "create"]
            }
          }
        },
