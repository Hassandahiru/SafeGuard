    {
      "name": "Settings Management",
      "item": [
        {
          "name": "Get User Settings",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Settings retrieved successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().success).to.be.true;",
                  "    pm.expect(pm.response.json().data.capabilities).to.exist;",
                  "    pm.expect(pm.response.json().data.profile).to.exist;",
                  "});",
                  "",
                  "// Save capabilities for other tests",
                  "if (pm.response.json().success) {",
                  "    const capabilities = pm.response.json().data.capabilities;",
                  "    pm.environment.set('can_manage_users', capabilities.canManageUsers || false);",
                  "    pm.environment.set('can_delete_building', capabilities.canDeleteBuildingAccount || false);",
                  "    pm.environment.set('can_request_licenses', capabilities.canRequestLicenses || false);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
